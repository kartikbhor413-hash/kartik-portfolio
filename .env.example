# ==============================================================================
# KARTIK BHOR PORTFOLIO - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file and rename the copy to `.env`
# 2. Fill in your real credentials in `.env`
# 3. Never commit or share your `.env` file!
# ==============================================================================

# Flask Settings
FLASK_SECRET_KEY=generate_a_random_32_character_secret_key_here
FLASK_ENV=development
PORT=5000

# Supabase PostgreSQL Configuration
# Dashboard: https://supabase.com/dashboard/project/uhreznoytbvlommykqpe
# Find these in: Project Settings -> API
SUPABASE_URL=https://uhreznoytbvlommykqpe.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here

# (Optional) Direct Database Connection URI
# Find in: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.uhreznoytbvlommykqpe.supabase.co:5432/postgres

# Email & SMTP Settings (Used to send 6-digit verification OTPs to visitors)
# For Gmail: Use smtp.gmail.com, port 587, and generate a 16-character "App Password"
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
MAIL_FROM="Kartik Bhor Portfolio" <your_email@gmail.com>

# Portfolio Owner Inbox (Where verified visitor contact messages are forwarded)
CONTACT_INBOX=your_personal_email@gmail.com

# Local Dev Mode Helper:
# If SMTP is not yet configured, the system logs the 6-digit OTP to the terminal console
# so you can test full OTP verification immediately without setup delay.
